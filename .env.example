# ════════════════════════════════════════════════════════════════════
#  VAIDYAASTRA — Environment Variables Template  (LOCAL SERVER ONLY)
#  No cloud services required — runs fully on your machine
# ════════════════════════════════════════════════════════════════════
#  HOW TO USE:
#  1. Copy this file:   cp .env.example .env   (or: copy .env.example .env on Windows)
#  2. Fill in the values marked with  <-- REQUIRED
#  3. NEVER commit .env to git
# ════════════════════════════════════════════════════════════════════

# ── APP IDENTITY ──────────────────────────────────────────────────────
APP_NAME=VaidyaAstra
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── SECRET KEYS  (generate: python -c "import secrets; print(secrets.token_hex(32))") ──
SECRET_KEY=                         # <-- REQUIRED
JWT_SECRET_KEY=                     # <-- REQUIRED
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── BACKEND SERVER ────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── DATABASE — SQLite (local file, no install needed) ─────────────────
SQLITE_DB_PATH=./data/vaidyaastra.db

# ── DATABASE — MongoDB (local, install from https://www.mongodb.com/try/download/community) ──
MONGODB_URI=mongodb://localhost:27017/vaidyaastra
MONGODB_DB_NAME=vaidyaastra

# ── AI — GOOGLE GEMINI API ────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=                     # <-- REQUIRED for AI features
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp
GEMINI_VISION_MODEL=gemini-1.5-pro
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.3

# ── MAPS — GOOGLE MAPS API (local frontend/backend integration) ───────
# Get key at: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# ── FILE STORAGE — LOCAL ONLY ─────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,dcm

# ── EMAIL — SMTP (optional, for OTP/notifications) ────────────────────
# Use Gmail app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@vaidyaastra.com
FROM_NAME=VaidyaAstra Health

# ── SMS — MSG91 (India, optional for OTP SMS) ─────────────────────────
# Get at: https://msg91.com/
MSG91_API_KEY=
MSG91_SENDER_ID=VASTRA
MSG91_TEMPLATE_OTP=

# ── OTP CONFIGURATION ─────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# ── RATE LIMITING ─────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AI_PER_HOUR=100
RATE_LIMIT_UPLOAD_PER_DAY=20
RATE_LIMIT_EMERGENCY_PER_HOUR=10

# ── PLATFORM ADMIN ────────────────────────────────────────────────────
PLATFORM_ADMIN_EMAIL=admin@vaidyaastra.com
PLATFORM_ADMIN_PASSWORD=            # <-- REQUIRED, set a strong password

# ── EMERGENCY SYSTEM ──────────────────────────────────────────────────
EMERGENCY_HOSPITAL_SEARCH_RADIUS_METERS=15000
EMERGENCY_MAX_HOSPITALS_TO_CHECK=5
EMERGENCY_AMBULANCE_UPDATE_INTERVAL_SECONDS=5
NATIONAL_EMERGENCY_NUMBER=112

# ── WEBSOCKET ──────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_MAX_CONNECTIONS_PER_USER=3

# ════════════════════════════════════════════════════════════════════
#  FRONTEND VARIABLES (Vite — MUST start with VITE_)
#  Safe to put non-secret values here. Never put backend secrets.
# ════════════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=VaidyaAstra
VITE_APP_TAGLINE=AI-Powered Universal Healthcare Operating System
VITE_EMERGENCY_PHONE=112
VITE_SUPPORT_EMAIL=support@vaidyaastra.com

# Google Maps key for frontend local usage
VITE_GOOGLE_MAPS_API_KEY=

# Feature flags (set to false to disable a section)
VITE_ENABLE_VIDEO_CONSULT=false
VITE_ENABLE_INSURANCE_MODULE=true
VITE_ENABLE_AMBULANCE_TRACKING=true
VITE_ENABLE_AI_SYMPTOM_CHECKER=true
VITE_ENABLE_MULTILINGUAL=true
